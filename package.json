{
  "name": "324-howard",
  "private": true,
  "version": "0.2.0",
  "description": "Renovation hub for 324 S Howard St, Gary, IN: before/after showcase, task board with work timer, and project journal.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "photos": "node scripts/photos.mjs",
    "video": "node scripts/video.mjs",
    "photos:prune": "node scripts/prune-photos.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "leaflet": "^1.9.4",
    "lucide": "1.48.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "exif-reader": "^2.0.3",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
